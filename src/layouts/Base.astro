---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { readFile } from 'node:fs/promises';
import { createHash } from 'node:crypto';
import { resolve } from 'node:path';
const iconVersion = createHash('sha256').update(await readFile(resolve('public/assets/favicon.svg'))).digest('hex').slice(0, 12);
const production = !import.meta.env.DEV && process.env.SITE_PUBLIC === '1';
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="A little learning. A wider world. Logos Learning Labs is a Canadian software studio making everyday learning a habit, starting with Flag Quiz.">
  <meta name="robots" content={production ? 'index, follow' : 'noindex, nofollow'}>
  {production && <link rel="canonical" href="https://logoslearninglabs.com/">}
  <meta name="theme-color" content="#0b1118">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_CA">
  <meta property="og:title" content="Logos Learning Labs — A little learning. A wider world.">
  <meta property="og:description" content="Thoughtfully made learning apps from Richmond, British Columbia.">
  {production && <meta property="og:url" content="https://logoslearninglabs.com/">}
  <title>Logos Learning Labs — A little learning. A wider world.</title>
  <link rel="icon" href={`/favicon.ico?v=${iconVersion}`} sizes="16x16 32x32 48x48 256x256" type="image/x-icon">
  <link rel="icon" href={`/favicon-32x32.png?v=${iconVersion}`} sizes="32x32" type="image/png">
  <link rel="icon" href={`/assets/favicon.svg?v=${iconVersion}`} sizes="any" type="image/svg+xml">
  <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${iconVersion}`} sizes="180x180">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/vendor/mint-ui/0.6.1/theme.css">
  <link rel="stylesheet" href="/vendor/mint-ui/0.6.1/components.css">
  <link rel="stylesheet" href="/styles/site.css">
  <script is:inline type="module" src="/scripts/site.js"></script>
</head>
<body class="mint-app">
  <a href="#main" class="skip-link mint-button">Skip to content</a>
  <SiteHeader />
  <main id="main"><slot /></main>
  <SiteFooter />
</body>
</html>
